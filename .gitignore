# yldot release assets (epic AIUE-9, decision 29): fetched by tests/yldot/tools/fetch_data.py into .data/<tag>/ and
# linked at their manifest paths (AIUE-84); never committed
tests/yldot/.data/
tests/yldot/references/*.h5

# Ticket and epic working documents: never committed; their lasting content goes to the ticket's or the epic's
# Confluence pages (.claude/context/branching.md). .claude/work/<KEY>/ is the working folder; the other paths are
# where these documents used to be committed (change_kind.py refuses them too).
.claude/work/
.claude/plans/
.claude/execution-reports/
.claude/system-reviews/
.claude/code-reviews/
docs/prds/
docs/specs/
docs/reviews/
docs/rca/

# yldot owner families (epic AIUE-9): grids, inputs.h5 and states are release assets (yldot-data-v<N>, owner
# 2026-10-19), listed with SHA-256 only in tests/yldot/references/<f>.manifest.json (owner, 2026-10-21) and fetched
# by tests/yldot/tools/fetch_data.py (AIUE-84)
tests/yldot/families/large_dd2c/*.h5
tests/yldot/families/large_dd2c/*.hdf5
tests/yldot/families/dnull_imp2/*.h5
tests/yldot/families/dnull_imp2/*.hdf5
