# AIUE-62: does the default OpenMP build import with the CI runner's distribution toolchain (Ubuntu 24.04 gcc)?
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gfortran gcc make git python3 python3-venv python3-dev libreadline-dev binutils ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git config --system --add safe.directory '*' && ln -s /usr/bin/python3 /usr/local/bin/python
